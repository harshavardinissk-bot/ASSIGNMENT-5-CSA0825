def summarize(text,k=2):
    import re,collections
    sentences=[s.strip() for s in re.split(r"[.!?]+",text) if s.strip()]
    stop={"the","and","is","in","to","a","of","was","are"}
    words=[w.lower() for w in re.findall(r"[A-Za-z]+",text) if w.lower() not in stop]
    freq=collections.Counter(words)
    ranked=sorted(enumerate(sentences),key=lambda z:(-sum(freq[w.lower()] for w in re.findall(r"[A-Za-z]+",z[1])),z[0]))
    return [sentences[i] for i,_ in sorted(ranked[:k])]
