POS={"good","clean","fast","helpful","improved"}
NEG={"bad","dirty","slow","rude","smoke","broken"}
NEGATORS={"not","never","no"}
def score(text):
    words=text.lower().replace("."," ").replace(","," ").split()
    total=0
    for i,w in enumerate(words):
        value=1 if w in POS else -1 if w in NEG else 0
        if i and words[i-1] in NEGATORS: value=-value
        total+=value
    return total
def label(text):
    s=score(text); return "positive" if s>0 else "negative" if s<0 else "neutral"
def summarize(text,k=2):
    import re,collections
    sentences=[s.strip() for s in re.split(r"[.!?]+",text) if s.strip()]
    stop={"the","and","is","in","to","a","of","was"}
    words=[w.lower() for w in re.findall(r"[a-z]+",text.lower()) if w not in stop]
    freq=collections.Counter(words)
    ranked=sorted(enumerate(sentences),key=lambda z:(-sum(freq[w] for w in re.findall(r"[a-z]+",z[1].lower())),z[0]))
    return [sentences[i] for i,_ in sorted(ranked[:k])]
def chatbot(question,con):
    words=question.lower().replace("?","").split()
    if "pm25" not in words and "pm2.5" not in words: return "Ask about PM2.5 and a station."
    station=next((s for s in ("adyar","guindy") if s in words),None)
    if not station: return "Please name a supported station."
    row=con.execute("SELECT AVG(r.pm25) FROM reading r JOIN station s ON s.station_id=r.station_id WHERE lower(s.station_name)=?",(station,)).fetchone()
    return f"PM2.5 for {station}: {row[0]}" if row and row[0] is not None else "No reading found."
print(label("The staff were not helpful."), label("Not bad, service improved."))
print(summarize("Smoke is bad. The road is dirty. Buses are slow."))
